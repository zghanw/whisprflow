{
  "name": "whisprflow",
  "productName": "WhisprFlow",
  "version": "2.0.2",
  "private": true,
  "description": "Voice dictation for Windows and macOS: press a hotkey, speak, and clean text lands in the current input. Runs on-device with Ollama, or with your own Gemini or OpenAI key",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-input",
    "speech-to-text",
    "macos",
    "gemini",
    "openai"
  ],
  "homepage": "https://github.com/zghanw/whisprflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zghanw/whisprflow.git"
  },
  "type": "module",
  "main": "src/app/main.mjs",
  "bin": {
    "whisprflow": "bin/whisprflow.mjs"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "start": "node bin/whisprflow.mjs",
    "build:native": "node scripts/build/build-native.mjs",
    "dist": "node scripts/build/package.mjs",
    "release": "node scripts/build/release.mjs",
    "install-app": "sh scripts/build/install-app.sh",
    "test": "npm run test:unit && npm run test:install",
    "test:unit": "node --test --test-timeout=5000 \"test/*.test.mjs\" \"test/!(install)/**/*.test.mjs\"",
    "test:install": "node --test --test-timeout=120000 \"test/install/**/*.test.mjs\"",
    "test:e2e": "node scripts/dev/e2e.mjs",
    "lint": "biome check .",
    "check": "biome check . && npm test"
  },
  "dependencies": {
    "@audio/decode-webm": "1.6.1",
    "@google/genai": "2.29.0",
    "electron": "44.7.0",
    "sherpa-onnx-node": "1.13.8",
    "transcribe-cpp": "0.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@audio/decode-opus": "1.3.3",
    "@biomejs/biome": "2.5.15",
    "@electron/get": "5.1.0",
    "@electron/packager": "20.3.0"
  }
}
